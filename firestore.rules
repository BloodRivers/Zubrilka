rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(data) {
      return signedIn() && data.owner_id == request.auth.uid;
    }
    function isPublic(data) {
      return data.public == true;
    }
    function realUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Публичный маркер релиза (версия для баннера в приложении)
    match /app/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /subjects/{id} {
      allow read: if signedIn() && resource.data.owner_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }

    match /notes/{id} {
      allow read: if (!signedIn() && isPublic(resource.data)) || (signedIn() && (isOwner(resource.data) || isPublic(resource.data)));
      allow create: if signedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }

    match /tests/{id} {
      allow read: if (!signedIn() && isPublic(resource.data)) || (signedIn() && (isOwner(resource.data) || isPublic(resource.data)));
      allow create: if signedIn() && request.resource.data.owner_id == request.auth.uid;
      // Друг может переименовать публичный тест, но не снять его с публикации и не забрать авторство.
      allow update: if isOwner(resource.data)
        || (realUser() && isPublic(resource.data)
          && request.resource.data.owner_id == resource.data.owner_id
          && request.resource.data.public == true);
      allow delete: if isOwner(resource.data);
    }

    match /test_results/{id} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /oral_results/{id} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /oral_progress/{id} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }
  }
}
