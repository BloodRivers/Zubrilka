PORT=4000
# ключ Polza.ai (внутренний, только на сервере)
POLZA_API_KEY=
# обычно не нужно менять: совместимый с OpenAI endpoint
POLZA_BASE_URL=https://api.polza.ai
POLZA_MODEL=anthropic/claude-sonnet-4.5
# JSON содержимое service account (Firebase Admin), для верификации ID-токена и usage_logs
FIREBASE_SERVICE_ACCOUNT=
